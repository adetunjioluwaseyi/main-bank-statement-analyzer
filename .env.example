# Optional for the later database-backed audit and report-history phase.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=statement_analyzer
MYSQL_USER=statement_analyzer_app
MYSQL_PASSWORD=

# Active Directory must be reachable from the Next.js server over LDAPS,
# or LDAP with StartTLS (LDAP_STARTTLS must not be false).
LDAP_URL=ldaps://your-domain-controller.example.com:636
LDAP_STARTTLS=true
LDAP_BASE_DN=DC=example,DC=com
LDAP_BIND_DN=CN=svc-statement-analyzer,OU=Service Accounts,DC=example,DC=com
LDAP_BIND_PW=
AD_EMAIL_DOMAIN=example.com

# Local development only. Allows access without an AD account.
DEV_AUTH_BYPASS=false

# Required to sign eight-hour, stateless AD sessions; use a random secret of 32+ bytes.
AD_SESSION_SECRET=
