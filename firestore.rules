rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'adetunjiiretomiwa@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['user', 'admin'] &&
             data.status in ['active', 'suspended'];
    }

    function isValidUpload(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.fileName is string && data.fileName.size() <= 256 &&
             data.uploadedAt is string && data.uploadedAt.size() <= 64;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && (
        (incoming().role == 'user' && incoming().status == 'active') || isSuperAdmin()
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && isValidUser(incoming()) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastActiveAt', 'uploadedFilesCount']) &&
         incoming().role == existing().role &&
         incoming().status == existing().status)
      );
      allow delete: if isSuperAdmin();
    }

    // Bank Statement Uploads Collection
    match /uploads/{uploadId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && isValidUpload(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid && isValidUpload(incoming()));
      allow delete: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }
  }
}
