# Copy this file to .env and fill in your real values.
# Keep .env out of Git.

# AI settings
GEMINI_API_KEY=your-gemini-api-key
STUDIO_MODEL=gemini-2.5-flash

# Optional: used for Vertex AI fallback / direct cloud call
GOOGLE_CLOUD_PROJECT=statement-analyzer-512616
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-3.8-flash

# PostgreSQL database for user records, upload metadata, credit ledger, audit logs
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/statement_analyzer
DB_HOST=localhost
DB_PORT=5432
DB_NAME=statement_analyzer
DB_USER=postgres
DB_PASSWORD=postgres

# Entra ID / Active Directory login settings
AD_TENANT_ID=your-tenant-id
AD_CLIENT_ID=your-app-client-id
AD_CLIENT_SECRET=your-app-client-secret
AD_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
AD_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
AD_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys

# Credit business rules
DEFAULT_USER_CREDIT_ALLOCATION=5000
ANALYSIS_CREDIT_COST=25
ADMIN_INITIAL_POOL_CREDITS=5000000
